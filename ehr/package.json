{
  "name": "clinic-ready-ehr",
  "version": "0.1.0",
  "private": true,
  "description": "Outpatient behavioral health EHR for Clinic Ready (demo/prototype).",
  "main": "server.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "seed": "node --no-warnings src/seed.js",
    "test": "node --no-warnings --test \"test/**/*.test.js\"",
    "backup": "node --no-warnings scripts/backup.js",
    "backup:verify": "node --no-warnings scripts/verify-backup.js",
    "backup:restore": "node --no-warnings scripts/restore-backup.js",
    "reset-admin": "node --no-warnings scripts/reset-admin.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "express": "^5.1.0"
  }
}
